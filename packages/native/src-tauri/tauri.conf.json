{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reemoat",
  "identifier": "com.reemoat.app",
  "version": "../../../package.json",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir ../.. --filter @reemoat/web dev",
    "beforeBuildCommand": "node scripts/build-frontend.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Reemoat",
        "width": 1100,
        "height": 760,
        "minWidth": 380,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "backgroundColor": "#f9f8f6",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: https:; font-src 'self'; connect-src 'self' https: wss: http: ws:; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": {
      "target/daemon/": "daemon"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Supervise a fleet of coding-agent sessions.",
    "longDescription": "Coding agents run on your own machines. Reemoat puts them behind one screen, so you can start one, approve a command and read what it did from anywhere.",
    "copyright": "Copyright (C) rends-east. AGPL-3.0-only.",
    "licenseFile": "../../../LICENSE",
    "homepage": "https://reemoat.com",
    "publisher": "rends-east",
    "createUpdaterArtifacts": false,
    "macOS": {
      "infoPlist": "Info.plist",
      "files": {
        "Helpers/Reemoat Runtime.app": "target/Helpers/Reemoat Runtime.app"
      },
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "signingIdentity": null,
      "providerShortName": null,
      "exceptionDomain": null
    },
    "iOS": {
      "developmentTeam": null,
      "minimumSystemVersion": "13.0"
    },
    "android": {
      "minSdkVersion": 24
    }
  },
  "plugins": {}
}
