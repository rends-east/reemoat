{
  "name": "reemoat",
  "version": "0.6.0",
  "description": "A daemon that owns coding-agent sessions and exposes them over HTTP and WebSocket, a control plane that issues identity and relays every request, and a web UI that supervises all of it from a phone.",
  "license": "AGPL-3.0-only",
  "author": "rends-east",
  "homepage": "https://reemoat.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rends-east/reemoat.git"
  },
  "bugs": {
    "url": "https://github.com/rends-east/reemoat/issues"
  },
  "keywords": [
    "coding-agent",
    "acp",
    "agent-client-protocol",
    "claude",
    "codex",
    "self-hosted"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "harness": "tsx scripts/harness.ts",
    "daemon": "UV_THREADPOOL_SIZE=${UV_THREADPOOL_SIZE:-64} tsx scripts/daemon.ts",
    "client": "tsx scripts/client.ts",
    "check": "pnpm typecheck && pnpm authcheck && pnpm daemoncheck && pnpm relaycheck && pnpm webcheck && pnpm pincheck && pnpm deploycheck && pnpm docscheck",
    "typecheck": "tsc --noEmit && pnpm --filter @reemoat/web typecheck",
    "authcheck": "tsx scripts/authcheck.ts",
    "daemoncheck": "tsx scripts/daemoncheck.ts",
    "deploycheck": "tsx scripts/deploycheck.ts",
    "docscheck": "tsx scripts/docscheck.ts",
    "relaycheck": "tsx scripts/relaycheck.ts",
    "pincheck": "tsx scripts/pincheck.ts",
    "imagecheck": "tsx scripts/imagecheck.ts",
    "webcheck": "tsx packages/web/scripts/webcheck.ts",
    "cp": "pnpm --filter @reemoat/control-plane cp",
    "cpctl": "pnpm --filter @reemoat/control-plane cpctl",
    "web": "pnpm --filter @reemoat/web dev",
    "web:build": "pnpm --filter @reemoat/web build"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.73.0",
    "@agentclientprotocol/codex-acp": "1.8.0",
    "@agentclientprotocol/sdk": "1.3.0",
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.1",
    "hono": "^4.13.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
